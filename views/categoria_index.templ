package views

import "ctrlstock/db"

templ CategoriaIndexPage(titulo string, categorias []db.Categoria, form DatosCategoriaForm) {
	@Layout(titulo, categoriaContenido(categorias, form))
}

templ categoriaContenido(categorias []db.Categoria, form DatosCategoriaForm) {
	@CategoriaForm(categorias, form)
	@CategoriaList(categorias)
}
