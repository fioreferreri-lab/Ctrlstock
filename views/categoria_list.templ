package views

import (
	"ctrlstock/db"
	"fmt"
)

// CategoriaList recibe las categorías que devuelve sqlc (ListCategorias)
// y las muestra en una tabla. Si no hay ninguna, muestra un mensaje.
templ CategoriaList(categorias []db.Categoria) {
	<section id="seccion-lista-categorias">
		<h2>Categorías</h2>
		if len(categorias) == 0 {
			<p><em>Todavía no hay categorías cargadas.</em></p>
		} else {
			<div class="overflow-auto">
				<table>
					<thead>
						<tr>
							<th>ID</th>
							<th>Nombre</th>
							<th>Categoría padre</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range categorias {
							<tr id={ fmt.Sprintf("categoria-%d", c.IDCategoria) }>
								<td>{ fmt.Sprint(c.IDCategoria) }</td>
								<td>{ c.Nombre }</td>
								<td>{ nombrePadreDe(c, categorias) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// nombrePadreDe busca en la lista el nombre de la categoría padre.
// En la base padre_id es opcional (NULL), por eso sqlc lo genera como
// sql.NullInt32. Si no tiene padre (o no se encuentra), devuelve un guion.
func nombrePadreDe(c db.Categoria, todas []db.Categoria) string {
	if !c.PadreID.Valid {
		return "—"
	}
	for _, p := range todas {
		if p.IDCategoria == c.PadreID.Int32 {
			return p.Nombre
		}
	}
	return "—"
}
