package views

import (
	"ctrlstock/db"
	"ctrlstock/logic"
	"fmt"
)

// MovimientoForm muestra el formulario para registrar un movimiento de stock.
// Recibe los productos para poder elegir a cuál se le aplica el movimiento.
// Recibe también los datos ya escritos y el error, para mostrarlos si algo falló.
templ MovimientoForm(productos []db.Producto, datos DatosMovimientoForm) {
	<section id="seccion-form-movimiento">
		<h2>Nuevo movimiento</h2>
		@alertaError(datos.Error)
		if len(productos) == 0 {
			<p><em>Cargá al menos un producto antes de registrar movimientos.</em></p>
		} else {
			<form method="post" action="/movimiento_stock">
				<label>
					Producto
					<select name="producto_id" required>
						<option value="" disabled selected?={ datos.ProductoID == "" }>Elegí un producto</option>
						for _, p := range productos {
							<option value={ fmt.Sprint(p.IDProducto) } selected?={ fmt.Sprint(p.IDProducto) == datos.ProductoID }>{ p.Nombre }</option>
						}
					</select>
				</label>
				<label>
					Tipo
					<select name="tipo" required>
						<option value="INGRESO" selected?={ datos.Tipo != "EGRESO" }>Ingreso</option>
						<option value="EGRESO" selected?={ datos.Tipo == "EGRESO" }>Egreso</option>
					</select>
				</label>
				<label>
					Cantidad
					<input type="number" name="cantidad" min="1" step="1" value={ datos.Cantidad } required/>
				</label>
				<label>
					Motivo
					<select name="motivo" required>
						<option value="" disabled selected?={ datos.Motivo == "" }>Elegí un motivo</option>
						<optgroup label="Para ingresos">
							for _, m := range logic.MotivosIngreso {
								<option value={ m } selected?={ datos.Motivo == m && datos.Tipo != "EGRESO" }>{ m }</option>
							}
						</optgroup>
						<optgroup label="Para egresos">
							for _, m := range logic.MotivosEgreso {
								<option value={ m } selected?={ datos.Motivo == m && datos.Tipo == "EGRESO" }>{ m }</option>
							}
						</optgroup>
					</select>
					<small>"Venta" es el motivo que cuenta para el ranking de Más vendidos.</small>
				</label>
				<button type="submit">Registrar movimiento</button>
			</form>
		}
	</section>
}
